{{ 'custom-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign heading_font = s.heading_font
  assign body_font = s.body_font
  assign upsell = s.upsell_product
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .gg-grid {
    --gg-font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --gg-font-heading-weight: {{ heading_font.weight }};
    --gg-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --gg-font-body-weight: {{ body_font.weight }};
  }
{%- endstyle -%}

<product-popup
  class="gg-grid"
  data-section-id="{{ section.id }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-cart-url="{{ routes.cart_url }}"
  data-money-format="{{ shop.money_format | escape }}"
  {%- if upsell != blank %}
    data-upsell-handle="{{ upsell.handle }}"
    data-upsell-id="{{ upsell.id }}"
  {%- endif %}
  data-text-add="{{ 'products.product.add_to_cart' | t }}"
  data-text-sold-out="{{ 'products.product.sold_out' | t }}"
  data-text-unavailable="{{ 'products.product.unavailable' | t }}"
  data-text-adding="Adding…"
  data-text-added-one="{{ 'sections.quick_order_list.items_added.one' | t: quantity: '[quantity]' }}"
  data-text-added-other="{{ 'sections.quick_order_list.items_added.other' | t: quantity: '[quantity]' }}"
  data-text-view-cart="{{ 'sections.quick_order_list.view_cart' | t }}"
  data-text-error="{{ 'sections.cart.cart_error' | t }}"
  data-text-choose="Choose your [option]"
  data-text-load-error="This product could not be loaded. Please try again."
>
  {%- if s.heading != blank -%}
    <h2 class="gg-grid__heading{% unless s.show_heading_desktop %} gg-grid__heading--mobile-only{% endunless %}">
      {{ s.heading | escape }}
    </h2>
  {%- endif -%}

  <ul class="gg-grid__list" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign product = block.settings.product
        assign image = block.settings.image
        if image == blank and product != blank
          assign image = product.featured_image
        endif
        assign alt = image.alt | default: product.title
        # first row is above the fold on desktop → eager, the rest lazy
        if forloop.index <= 3
          assign loading = 'eager'
        else
          assign loading = 'lazy'
        endif
      -%}
      <li class="gg-grid__tile{% if product == blank %} gg-grid__tile--empty{% endif %}" {{ block.shopify_attributes }}>
        {%- if image != blank -%}
          {{-
            image
            | image_url: width: 1100
            | image_tag:
              widths: '375, 550, 750, 920, 1100',
              sizes: '(min-width: 1101px) 447px, 50vw',
              loading: loading,
              class: 'gg-grid__img',
              alt: alt
          -}}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'gg-grid__placeholder' }}
        {%- endif -%}

        {%- if product != blank -%}
          <button
            type="button"
            class="gg-hotspot"
            style="--gg-x: {{ block.settings.hotspot_x }}%; --gg-y: {{ block.settings.hotspot_y }}%;"
            data-product-handle="{{ product.handle }}"
            aria-haspopup="dialog"
            aria-label="Quick view {{ product.title | escape }}"
          >
            <span class="gg-hotspot__icon" aria-hidden="true"></span>
          </button>
        {%- elsif request.design_mode -%}
          <span class="gg-grid__empty-label">Select a product</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>

  {%- comment -%} One dialog for the whole section; populated on click. {%- endcomment -%}
  {%- render 'product-popup', section_id: section.id -%}
</product-popup>

<script src="{{ 'custom-popup.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Gift Guide Grid",
  "tag": "section",
  "class": "section-gg-grid",
  "enabled_on": {
    "templates": ["page", "index"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "checkbox",
      "id": "show_heading_desktop",
      "label": "Show heading on desktop",
      "info": "Mobile always shows the heading.",
      "default": true
    },
    {
      "type": "product",
      "id": "upsell_product",
      "label": "Upsell product (Soft Winter Jacket)",
      "info": "Added automatically, in the same request, whenever a variant with the options \"Black\" and \"Medium\" is added from the quick view. Skipped when unset or sold out."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font (serif)",
      "default": "jost_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "jost_n4"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product tile",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle image",
          "info": "Optional. Falls back to the product's featured image."
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}

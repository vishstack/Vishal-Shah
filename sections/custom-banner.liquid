{{ 'custom-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-banner.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign heading_font = s.heading_font
  assign body_font = s.body_font

  assign image_desktop = s.image_desktop
  assign image_mobile = s.image_mobile
  if image_mobile == blank
    assign image_mobile = image_desktop
  endif

  assign hero_alt = s.heading | strip_html
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .gg-banner {
    --gg-font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --gg-font-heading-weight: {{ heading_font.weight }};
    --gg-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --gg-font-body-weight: {{ body_font.weight }};
  }

  {%- if s.hide_theme_chrome -%}
    .shopify-section-group-header-group,
    .shopify-section-group-footer-group {
      display: none;
    }
  {%- endif -%}
{%- endstyle -%}

<section
  class="gg-banner"
  style="
    --gg-color-black: #000000;
    --gg-color-white: #ffffff;
    --gg-topbar-bg: {{ s.topbar_bg }};
    --gg-gift-bg: {{ s.gift_bg }};
    --gg-gift-text: {{ s.gift_text }};
    --gg-strip-bg: {{ s.strip_bg }};
    --gg-button-bg: {{ s.button_bg }};
    --gg-button-text: {{ s.button_text }};
  "
>
  {%- comment -%}
    1. Top bar
    Mobile: the hamburger is a <details> disclosure (keyboard accessible with no
    JS) that reveals the tagline + CHOOSE GIFT in a panel under the bar and swaps
    its icon to "×" when open. custom-banner.js adds ESC / outside-click closing.
    Desktop: the disclosure is hidden and the same tagline/button sit inline.
  {%- endcomment -%}
  <gift-topbar class="gg-topbar">
    <details class="gg-topbar__nav">
      <summary class="gg-topbar__menu" aria-label="Menu">
        <svg class="gg-topbar__icon gg-topbar__icon--open" viewBox="0 0 22 14" width="22" height="14" aria-hidden="true" focusable="false">
          <path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.6" fill="none"/>
        </svg>
        <svg class="gg-topbar__icon gg-topbar__icon--close" viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
        </svg>
      </summary>
      <div class="gg-topbar__panel">
        {%- if s.topbar_text != blank -%}
          <p class="gg-topbar__panel-text">{{ s.topbar_text | escape }}</p>
        {%- endif -%}
        {%- if s.gift_label != blank -%}
          <a class="gg-btn gg-btn--gift" href="{{ s.gift_link | default: '#' }}">
            <span class="gg-btn__label">{{ s.gift_label | escape }}</span>
            {%- render 'gg-arrow-icon' -%}
          </a>
        {%- endif -%}
      </div>
    </details>

    {%- comment -%}
      Brand: the Figma export uses a 151.44 × 19 logo SVG. When a logo image is
      uploaded it is shown at that size; otherwise the text is styled to match it.
    {%- endcomment -%}
    <p class="gg-topbar__brand">
      {%- if s.logo != blank -%}
        {{-
          s.logo
          | image_url: width: 460
          | image_tag:
            widths: '152, 304, 456',
            sizes: '152px',
            class: 'gg-topbar__logo',
            loading: 'eager',
            alt: s.brand_text
        -}}
      {%- else -%}
        {{- s.brand_text | escape -}}
      {%- endif -%}
    </p>

    {%- if s.topbar_text != blank -%}
      <p class="gg-topbar__text">{{ s.topbar_text | escape }}</p>
    {%- endif -%}

    {%- if s.gift_label != blank -%}
      <a class="gg-btn gg-btn--gift gg-topbar__gift" href="{{ s.gift_link | default: '#' }}">
        <span class="gg-btn__label">{{ s.gift_label | escape }}</span>
        {%- render 'gg-arrow-icon' -%}
      </a>
    {%- endif -%}
  </gift-topbar>

  {%- comment -%} 2. Hero {%- endcomment -%}
  <div class="gg-hero">
    <div class="gg-hero__media">
      {%- if image_mobile != blank -%}
        <picture>
          {%- if image_desktop != blank -%}
            <source
              media="(min-width: 768px)"
              srcset="
                {{ image_desktop | image_url: width: 1440 }} 1440w,
                {{ image_desktop | image_url: width: 1920 }} 1920w,
                {{ image_desktop | image_url: width: 2880 }} 2880w,
                {{ image_desktop | image_url: width: 3840 }} 3840w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {{-
            image_mobile
            | image_url: width: 1500
            | image_tag:
              widths: '375, 550, 750, 1100, 1500',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'gg-hero__img',
              alt: hero_alt
          -}}
        </picture>
      {%- else -%}
        <div class="gg-hero__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'gg-hero__placeholder-svg' }}</div>
      {%- endif -%}
    </div>

    {%- comment -%} Copy block: overlaid bottom-left on desktop, stacked on mobile {%- endcomment -%}
    <div class="gg-hero__content">
      <h1 class="gg-hero__heading">{{ s.heading | escape }}</h1>

      <p class="gg-hero__text gg-hero__text--desktop">{{ s.text_desktop | escape }}</p>
      <p class="gg-hero__text gg-hero__text--mobile">{{ s.text_mobile | escape }}</p>

      {%- if s.shop_label != blank -%}
        <a class="gg-btn gg-btn--shop" href="{{ s.shop_link | default: '#' }}">
          <span class="gg-btn__label">{{ s.shop_label | escape }}</span>
          {%- render 'gg-arrow-icon' -%}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="gg-strip">
    <p class="gg-strip__text gg-strip__text--desktop">{{ s.strip_text_desktop | escape }}</p>
    <p class="gg-strip__text gg-strip__text--mobile">{{ s.strip_text_mobile | escape }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Gift Guide Banner",
  "tag": "section",
  "class": "section-gg-banner",
  "enabled_on": {
    "templates": ["page", "index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "info": "Also used as the logo's alt text.",
      "default": "TISSO VISON"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image (optional)",
      "info": "Shown 19px tall (151 × 19 in Figma). Leave empty to use the brand text."
    },
    {
      "type": "text",
      "id": "topbar_text",
      "label": "Center text (desktop only)",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "gift_label",
      "label": "Button label (desktop only)",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "gift_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "text_desktop",
      "label": "Paragraph (desktop)",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "textarea",
      "id": "text_mobile",
      "label": "Paragraph (mobile)",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Illustration (desktop)",
      "info": "The hero takes the image's own proportion. Use the 1440 × 780 Figma illustration (export at 2×: 2880 × 1560)."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Illustration (mobile)",
      "info": "Mobile crop shown below the text (375 × 264 area in Figma; export at 2×). Falls back to the desktop image."
    },
    {
      "type": "header",
      "content": "Strip"
    },
    {
      "type": "text",
      "id": "strip_text_desktop",
      "label": "Strip text (desktop)",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "text",
      "id": "strip_text_mobile",
      "label": "Strip text (mobile)",
      "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "topbar_bg",
      "label": "Top bar background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "gift_bg",
      "label": "CHOOSE GIFT background",
      "default": "#FFF544"
    },
    {
      "type": "color",
      "id": "gift_text",
      "label": "CHOOSE GIFT text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "strip_bg",
      "label": "Strip background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "SHOP NOW background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "SHOP NOW text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "jost_n5"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "jost_n4"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "hide_theme_chrome",
      "label": "Hide theme header and footer",
      "info": "The top bar above replaces Dawn's header on this page. Hides the header and footer section groups with CSS; the theme layout is not modified.",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}
